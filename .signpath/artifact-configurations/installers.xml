<?xml version="1.0" encoding="utf-8"?>
<!-- Stage 2 of the release: the installers are signed here. The single-file programs copied beside them were signed in stage 1 and pass through unchanged. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="*-Setup-*-win-x64.exe" max-matches="unbounded"/>
      <for-each>
        <authenticode-sign/>
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
