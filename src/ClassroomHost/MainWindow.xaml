<Window x:Class="ClassroomManager.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClassroomManager.Host"
        Title="Dausuva Classroom Manager" Width="1250" Height="720" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen" Icon="host.ico" PreviewKeyDown="MainWindow_PreviewKeyDown">
    <DockPanel Margin="10">

        <Popup x:Name="CommandSearchPopup" PlacementTarget="{Binding ElementName=CommandSearchBox}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="1" Padding="4" MinWidth="330">
                <StackPanel>
                    <TextBlock x:Name="CommandSearchEmpty" Text="No matching commands" Margin="8" Visibility="Collapsed"/>
                    <ListBox x:Name="CommandSearchResults" MaxHeight="320" MinWidth="320"
                             AutomationProperties.Name="Matching commands" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewKeyDown="CommandSearchResults_PreviewKeyDown">
                        <ListBox.Resources>
                            <!-- A real button owns mouse capture and raises Click on release. -->
                            <Style x:Key="CommandSearchResultStyle" TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </StackPanel>
            </Border>
        </Popup>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="TabHeaderSpace" Height="1" VerticalAlignment="Top" IsHitTestVisible="False"/>
          <!-- Tag carries the available header width into the items-panel template. Content keeps the full width. -->
          <TabControl x:Name="MainTabs" Grid.ColumnSpan="2" Tag="{Binding ActualWidth, ElementName=TabHeaderSpace}" SelectionChanged="MainTabs_SelectionChanged">
          <TabControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel HorizontalAlignment="Left" MaxWidth="{Binding Tag, RelativeSource={RelativeSource AncestorType=TabControl}}"/>
            </ItemsPanelTemplate>
          </TabControl.ItemsPanel>
          <TabControl.Resources>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
              <Setter Property="Margin" Value="0,0,8,8"/>
            </Style>
            <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
              <Setter Property="Margin" Value="0,0,8,8"/>
            </Style>
            <Style x:Key="ToolbarPanelStyle" TargetType="WrapPanel">
              <Setter Property="Margin" Value="6"/>
            </Style>
            <Style x:Key="ToolbarGroupLabelStyle" TargetType="Label">
              <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter Property="MinHeight" Value="32"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="VerticalContentAlignment" Value="Center"/>
              <Setter Property="VerticalAlignment" Value="Top"/>
              <Setter Property="Margin" Value="0,0,8,8"/>
            </Style>
            <Style x:Key="ToolbarFieldLabelStyle" TargetType="Label" BasedOn="{StaticResource ToolbarGroupLabelStyle}">
              <Setter Property="FontWeight" Value="Normal"/>
              <Setter Property="Margin" Value="12,0,6,8"/>
            </Style>
          </TabControl.Resources>
          <TabItem Header="Overview">
           <WrapPanel x:Name="BuiltInQuickActionsPanel" Style="{StaticResource ToolbarPanelStyle}">
            <Label Content="Quick actions:" Style="{StaticResource ToolbarGroupLabelStyle}"/>
           </WrapPanel>
          </TabItem>

          <TabItem Header="Computers">
           <StackPanel>
           <WrapPanel Style="{StaticResource ToolbarPanelStyle}">
            <Button x:Name="ScanButton" Style="{StaticResource PrimaryActionButtonStyle}" Tag="&#128269;" Content="_Scan network" ToolTip="Scan network — discover Classroom Client computers on the subnet selected in Host settings without polling unassigned computers." Click="Scan_Click"/>
            <Button Tag="&#10133;" Content="_Add computer..." ToolTip="Add computer — remember one or more addresses manually." Click="Add_Click"/>
            <Button Tag="&#128274;" Content="Approve _certificate..." ToolTip="Approve certificate — look at the certificate the selected computer presents, see whether it is new or changed, and trust it with one click, as on the first SSH connection." Click="ApproveCertificate_Click"/>
            <Button Tag="&#9889;" Content="_Wake up" ToolTip="Wake up — send Wake-on-LAN packets to selected computers; on computers that are already on, stop the screen saver and turn the display on." Click="Wake_Click"/>
            <Button Tag="&#128260;" Content="Re_fresh status" ToolTip="Refresh status (F5) — check computers assigned to rooms now." Click="Refresh_Click"/>
            <Button Style="{StaticResource DestructiveActionButtonStyle}" Tag="&#128268;" Content="Power..." ToolTip="Power — shut down, restart, log off or cancel a pending action." Click="Power_Click"/>
            <Button Tag="&#8617;" Content="Cancel pending shutdown" ToolTip="Cancel pending shutdown — call off a shutdown or restart that was sent with a delay and has not happened yet." Click="CancelPower_Click"/>
            <Button Tag="&#128465;" Content="Windows Update..." ToolTip="Windows Update — check, select, install, pause, resume, or restart for updates on selected computers." Click="WindowsUpdate_Click"/>
            <Label Content="Room:" Target="{Binding ElementName=RoomBox}" Style="{StaticResource ToolbarFieldLabelStyle}"/>
            <ComboBox x:Name="RoomBox" Width="150" MinHeight="36" Padding="8,4"
                      VerticalAlignment="Top" VerticalContentAlignment="Center" SelectionChanged="RoomBox_SelectionChanged" Margin="0,0,8,8"/>
            <Button Tag="&#127991;" Content="Assi_gn to room..." ToolTip="Assign to room — group selected computers and enable their status monitoring." Click="AssignRoom_Click"/>
            <Button Tag="&#9999;" Content="Display _name..." ToolTip="Display name — give the selected computer a label that only this Host shows. The computer is not renamed." Click="SetDisplayName_Click"/>
            <Button Style="{StaticResource DestructiveActionButtonStyle}" Tag="&#9999;" Content="Rena_me computer..." ToolTip="Rename computer — change the Windows computer name of the selected computer. It takes effect after a restart." Click="RenameComputer_Click"/>
           </WrapPanel>
           <Expander Header="More computer-list actions" Margin="6,0,6,6">
            <WrapPanel Style="{StaticResource ToolbarPanelStyle}">
             <Button Style="{StaticResource DestructiveActionButtonStyle}" Tag="&#10134;" Content="_Remove" ToolTip="Remove — forget the selected computers." Click="Remove_Click"/>
             <Button Style="{StaticResource DestructiveActionButtonStyle}" Tag="&#128465;" Content="Remove _offline" ToolTip="Remove offline — forget all computers currently marked offline." Click="RemoveOffline_Click"/>
             <Button Tag="&#128228;" Content="_Export list..." ToolTip="Export list — save computer names, addresses, MACs and rooms." Click="ExportList_Click"/>
             <Button Tag="&#128229;" Content="_Import list..." ToolTip="Import list — merge computers from a saved JSON list." Click="ImportList_Click"/>
             <Button Tag="&#128100;" Content="Sign in _user..." ToolTip="Sign in user — restart selected computers that nobody is using and sign one account in, to prepare a room before a lesson." Click="SignInUser_Click"/>
            </WrapPanel>
           </Expander>
           </StackPanel>
          </TabItem>

          <TabItem Header="Classroom">
           <StackPanel>
           <WrapPanel Style="{StaticResource ToolbarPanelStyle}">
            <Button Style="{StaticResource PrimaryActionButtonStyle}" Tag="&#128172;" Content="_Message..." ToolTip="Message — show a notice to signed-in students." Click="Message_Click"/>
            <Button Tag="&#8617;" Content="_Hide messages" ToolTip="Hide messages — close any message windows previously shown by Classroom Manager." Click="HideMessages_Click"/>
            <Button Tag="&#128274;" Content="_Lock screen..." ToolTip="Lock screen — cover student displays with a teacher message." Click="Lock_Click"/>
            <Button Tag="&#128275;" Content="_Unlock" ToolTip="Unlock — remove the Classroom Manager screen lock." Click="Unlock_Click"/>
            <Button Tag="&#128444;" Content="Set _wallpaper..." ToolTip="Set wallpaper — preview and apply a library image, Windows solid color, or the Windows default wallpaper." Click="Wallpaper_Click"/>
            <Button Tag="&#127760;" Content="Open website..." ToolTip="Open website — launch an HTTP or HTTPS address for the signed-in users on selected computers." Click="OpenWebsite_Click"/>
            <Button Tag="&#9654;" Content="Open program..." ToolTip="Open program — start a program for the signed-in users on selected computers." Click="OpenProgram_Click"/>
           </WrapPanel>
           <Expander Header="More desktop and appearance actions" Margin="6,0,6,6">
            <WrapPanel Style="{StaticResource ToolbarPanelStyle}">
             <Button Tag="&#128339;" Content="Sync time..." ToolTip="Sync time — correct the clocks on selected computers." Click="SyncTime_Click"/>
             <Button Tag="&#128444;" Content="Managed wallpapers..." ToolTip="Managed wallpapers — inspect and remove Classroom Manager wallpaper copies on one selected computer." Click="ManagedWallpapers_Click"/>
             <Button Tag="&#128444;" Content="Recent wallpapers..." ToolTip="Recent wallpapers — see the Recent images of the students' Background settings with a preview, and remove pictures from that list." Click="RecentWallpapers_Click"/>
             <Button Tag="&#9680;" Content="Appearance settin_gs..." ToolTip="Appearance settings — see every appearance setting the selected computers support (colours, desktop icons, wallpaper fit and more), change several at once, save them as a preset and put them back." Click="AppearanceSettings_Click"/>
             <Button Tag="&#9680;" Content="Windows _themes..." ToolTip="Windows themes — list and apply themes available to the signed-in user on one selected computer." Click="WindowsThemes_Click"/>
             <Button Tag="&#9680;" Content="Windows _appearance &amp; language..." ToolTip="Windows appearance and language — set Light/Dark mode and the signed-in user's Windows interface language." Click="WindowsPreferences_Click"/>
             <Button Tag="&#128421;" Content="Screen sa_ver..." ToolTip="Screen saver — turn off, choose, or install a screen saver for the signed-in users on selected computers." Click="ScreenSaver_Click"/>
             <Button Tag="&#9000;" Content="_Keyboard layouts..." ToolTip="Keyboard layouts — compare the keyboard layouts of the selected computers, add or remove one, choose the default, and keep a room default." Click="KeyboardLayouts_Click"/>
             <Button Tag="&#128433;" Content="M_ouse..." ToolTip="Mouse settings — change pointer speed, buttons and scrolling." Click="Mouse_Click"/>
             <Button Tag="&#8617;" Content="Reset mous_e" ToolTip="Reset mouse — restore standard Windows mouse defaults." Click="MouseReset_Click"/>
             <Button Tag="&#128465;" Content="Rec_ycle Bin..." ToolTip="Recycle Bin — empty the Recycle Bin of the signed-in users on selected computers, or reset its name to the Windows default." Click="RecycleBinEmpty_Click"/>
             <Button Tag="&#9638;" Content="Reset desktop layout..." ToolTip="Reset desktop layout — restore icon size/arrangement or taskbar placement for signed-in users." Click="DesktopLayoutReset_Click"/>
            </WrapPanel>
           </Expander>
           </StackPanel>
          </TabItem>

          <TabItem Header="Files">
           <WrapPanel Style="{StaticResource ToolbarPanelStyle}">
            <Button Style="{StaticResource PrimaryActionButtonStyle}" Tag="&#128232;" Content="_Send files..." ToolTip="Send files — deliver files to student folders." Click="SendFiles_Click"/>
            <Button Tag="&#128203;" Content="Transfer _history..." ToolTip="Transfer history — review sent files and safely undo unchanged deliveries." Click="TransferHistory_Click"/>
            <Button Tag="&#128229;" Content="_Collect files..." ToolTip="Collect files — download matching student files into per-student folders." Click="Collect_Click"/>
            <Button Tag="&#128338;" Content="_Recent files..." ToolTip="Recent files — list what the students changed in their watched folders lately, and copy it to this PC." Click="RecentFiles_Click"/>
            <Button Tag="&#128193;" Content="_Browse files..." ToolTip="Browse files — manage one computer or compare and operate on one shared path across selected computers." Click="Files_Click"/>
           </WrapPanel>
          </TabItem>

          <TabItem Header="Software">
           <StackPanel>
           <WrapPanel Style="{StaticResource ToolbarPanelStyle}">
            <Button Style="{StaticResource PrimaryActionButtonStyle}" Tag="&#128230;" Content="_Install / uninstall..." ToolTip="Install or uninstall — deploy installers, winget packages or registry files." Click="Install_Click"/>
            <Button Tag="&#9776;" Content="_Programs..." ToolTip="Programs — inspect one computer or compare versions and batch uninstall across selected computers." Click="Programs_Click"/>
            <Button Tag="&#128202;" Content="Processes..." ToolTip="Processes — inspect one computer or compare user processes across selected computers." Click="Processes_Click"/>
            <Button Tag="&#9654;" Content="_Run command..." ToolTip="Run command — execute a command on selected computers." Click="Command_Click"/>
            <Button Tag="&#127760;" Content="Browsers..." ToolTip="Browsers — stop new profiles and guest windows, clear browsing data now or whenever the browser closes, and remove extra profiles in Chrome, Edge and Firefox." Click="Browsers_Click"/>
            <Button Tag="&#128465;" Content="Browser pro_files..." ToolTip="Browser profiles — list the browser profiles of one computer and remove the ones you choose, with their bookmarks and saved passwords." Click="BrowserProfiles_Click"/>
           </WrapPanel>
           <Expander Header="More remote administration tools" Margin="6,0,6,6">
            <WrapPanel Style="{StaticResource ToolbarPanelStyle}">
             <Button Tag="&#128230;" Content="_Temporary uploads..." ToolTip="Temporary uploads — upload installers once, review or clean this Host's private staging files, and install synchronized uploads." Click="StagedUploads_Click"/>
             <Button Tag="&#11014;" Content="_Update client..." ToolTip="Update client — upload and apply a signed Classroom Client build." Click="UpdateClient_Click"/>
             <Button Tag="&#128465;" Content="Uninstall client..." ToolTip="Uninstall client — remove Classroom Client from one computer, after you type its name. Needs an Admin key." Click="UninstallClient_Click"/>
             <Button Tag="&#9000;" Content="Terminal..." ToolTip="Terminal — open an interactive remote shell on one computer." Click="Terminal_Click"/>
             <Button Tag="&#128194;" Content="Re_gistry..." ToolTip="Registry — inspect or edit the selected computer's registry." Click="Registry_Click"/>
             <Button Tag="&#9200;" Content="_Scheduled tasks..." ToolTip="Scheduled tasks — inspect one computer or inventory and manage tasks across selected computers." Click="Tasks_Click"/>
             <Button Tag="&#128640;" Content="_Autoruns..." ToolTip="Autoruns — review programs configured to start automatically." Click="Autoruns_Click"/>
            </WrapPanel>
           </Expander>
           </StackPanel>
          </TabItem>

          <TabItem Header="Restrictions">
           <WrapPanel Style="{StaticResource ToolbarPanelStyle}">
            <Button Style="{StaticResource PrimaryActionButtonStyle}" Tag="&#128260;" Content="Website blocklist _sync..." ToolTip="Website blocklist sync — collect app-managed website blocks from selected computers, define the Host default, and enforce it on that selection." Click="WebsiteBlockSync_Click"/>
            <Button Tag="&#127760;" Content="Block _websites..." ToolTip="Block websites — manage the client-owned hosts-file block list." Click="BlockWebsites_Click"/>
            <Button Tag="&#128269;" Content="Websites in _use..." ToolTip="Websites in use — see which websites are open in the browsers of the selected computers right now, and block the ones you tick." Click="SitesInUse_Click"/>
            <Button Tag="&#128221;" Content="Website dra_fts..." ToolTip="Website drafts — websites you noted to block later. Nothing is blocked until you choose Block the ticked websites." Click="WebsiteDrafts_Click"/>
            <Button Tag="&#128683;" Content="Block _apps..." ToolTip="Block apps — stop named processes from running." Click="BlockApps_Click"/>
            <ToggleButton x:Name="ExamModeToggle" Tag="&#128221;" Content="Exam mode" ToolTip="Apply or remove the configured exam website/app overlay on every visible assigned computer." Click="ExamModeToggle_Click" Margin="6,0,8,8" VerticalAlignment="Top"/>
            <Button Tag="&#9881;" Content="Exam mode settings..." ToolTip="Exam mode settings — configure the websites and programs blocked by the exam overlay." Click="ExamModeSettings_Click"/>
           </WrapPanel>
          </TabItem>

          <TabItem Header="Reports">
           <WrapPanel Style="{StaticResource ToolbarPanelStyle}">
            <Button Style="{StaticResource PrimaryActionButtonStyle}" Tag="&#128100;" Content="_Local accounts..." ToolTip="Local accounts — manage one computer or compare account inventory across selected computers." Click="Accounts_Click"/>
            <Button Tag="&#128100;" Content="_Signed-in accounts..." ToolTip="Signed-in accounts — inspect active Windows identities and stored app/account credentials across selected computers." Click="SignedInAccounts_Click"/>
            <Button Tag="&#128100;" Content="_App accounts..." ToolTip="App accounts — see which accounts the students' apps are signed in to: OneDrive, Microsoft 365, Teams, Dropbox, Google Drive, Steam, Spotify and browser profiles." Click="AppAccounts_Click"/>
            <Button x:Name="ExportInventoryButton" Tag="&#128203;" Content="_Export inventory..." ToolTip="Export inventory — save hardware and installed-software reports." Click="Inventory_Click"/>
           </WrapPanel>
          </TabItem>

          <TabItem x:Name="SettingsTab" Header="Settings">
           <StackPanel>
           <WrapPanel Style="{StaticResource ToolbarPanelStyle}">
            <Button x:Name="HostModeButton" Tag="&#128100;" Content="Mode: Teacher" ToolTip="Switch between the reduced Teacher command profile and the full Admin interface. This is a UI profile, not authentication." Click="HostMode_Click"/>
            <Button Tag="&#9733;" Content="Custom _quick actions..." ToolTip="Custom quick actions — make your own quick actions: open a program or website, show a message, lock, sleep or shut down after a delay, or sync files from the students to this computer." Click="CustomQuickActions_Click"/>
            <Button Tag="&#9776;" Content="Arrange _toolbar..." ToolTip="Arrange toolbar — move actions between each tab's top row and its &quot;More&quot; part, put them in your order, or hide the ones you do not use." Click="ArrangeToolbar_Click"/>
            <Button Tag="&#128421;" Content="_Interface settings..." ToolTip="Interface settings — choose appearance, quick actions, and the commands visible in Teacher mode." Click="InterfaceSettings_Click"/>
            <Button Style="{StaticResource PrimaryActionButtonStyle}" Tag="&#9881;" Content="_Host settings..." ToolTip="Host settings — configure keys, discovery subnet, ports, TLS, schedules, automatic refresh, and diagnostics." Click="Settings_Click"/>
            <Button Tag="&#128197;" Content="_Schedules..." ToolTip="Schedules — manage timed classroom actions stored on this Host." Click="Schedules_Click"/>
            <Button Tag="&#128229;" Content="I_mport teacher settings..." ToolTip="Import teacher settings — take the key, computers and presets from a file your administrator exported." Click="ImportTeacherSettings_Click"/>
            <Button Tag="&#128172;" Content="Message to administrator..." ToolTip="Message to administrator — leave a note for whoever looks after this lab, for example a computer that needs attention." Click="MessageToAdministrator_Click"/>
           </WrapPanel>
           <Expander Header="More administration and support actions" Margin="6,0,6,6">
            <WrapPanel Style="{StaticResource ToolbarPanelStyle}">
             <Button Tag="&#127760;" Content="Languages..." ToolTip="Languages — see the available languages, add one you translated yourself, or save the texts to translate." Click="Languages_Click"/>
             <Button Tag="&#9733;" Content="Command _favourites..." ToolTip="Command favourites — save named commands with their cmd or PowerShell shell and SYSTEM or signed-in-user privilege." Click="FavoriteCommands_Click"/>
             <Button Tag="&#9881;" Content="_Crash logs..." ToolTip="Crash logs — review or clear locally captured Host crash reports." Click="CrashLogs_Click"/>
             <Button Tag="&#128273;" Content="_Lab keys..." ToolTip="Lab keys — add and manage named shared keys for independently configured labs." Click="LabKeys_Click"/>
             <Button Tag="&#128273;" Content="Sec_ure this lab..." ToolTip="Secure this lab — ask the computers and list what is weaker than it should be: approvals, keys, old Clients, discovery, security events. It changes nothing." Click="SecureLab_Click"/>
             <Button Tag="&#128273;" Content="Acc_ess keys..." ToolTip="Access keys — add or revoke named Teacher and Admin keys on the selected computers." Click="AccessKeys_Click"/>
             <Button Tag="&#128228;" Content="E_xport teacher settings..." ToolTip="Export teacher settings — create a Teacher key on the selected computers and save it with their list and your classroom presets in one file for a teacher to import." Click="ExportTeacherSettings_Click"/>
             <Button Tag="&#128172;" Content="Messages from teachers..." ToolTip="Messages from teachers — read the notes teachers left for the administrator on this computer, and remove the ones dealt with." Click="MessagesFromTeachers_Click"/>
             <Button Tag="&#10067;" Content="Setup assistant..." ToolTip="Setup assistant — the first steps again: take a key or a settings file, find the computers and put them in a room." Click="SetupAssistant_Click"/>
             <Button Tag="&#128228;" Content="Export configuration..." ToolTip="Export configuration — save every setting and every key of this Host in one password-protected file, as a backup or to move to another computer." Click="ExportConfiguration_Click"/>
             <Button Tag="&#128229;" Content="Import configuration..." ToolTip="Import configuration — replace this Host's settings and keys with an exported configuration file. The current ones are kept as a backup." Click="ImportConfiguration_Click"/>
             <Button Tag="&#128229;" Content="Settings backups..." ToolTip="Settings backups — see the earlier copies of this Host's settings and keys that are kept automatically, and put one back." Click="SettingsBackups_Click"/>
             <Button Style="{StaticResource DestructiveActionButtonStyle}" Tag="&#128273;" Content="_Rotate shared key..." ToolTip="Rotate shared key — replace the administration key on selected client computers." Click="RotateKey_Click"/>
            </WrapPanel>
           </Expander>
           </StackPanel>
          </TabItem>
          <TabItem Header="Help">
           <WrapPanel Style="{StaticResource ToolbarPanelStyle}">
            <Button Tag="&#10067;" Content="Help" ToolTip="Help (F1) — open the teacher guide with pictures, in your language." Click="Help_Click"/>
            <Button x:Name="InstallHereButton" Visibility="Collapsed" Tag="&#128229;" Content="_Install on this computer..." ToolTip="Install on this computer — copy this program to your own program folder and add it to the Start menu and Settings > Apps. No administrator rights; your settings stay as they are." Click="InstallHere_Click"/>
            <Button Tag="&#9432;" Content="_About..." ToolTip="About — show product, version, runtime and copyright information." Click="About_Click"/>
            <Button Tag="&#9997;" Content="Send feedback..." ToolTip="Send feedback (Ctrl+Shift+F) — describe the screen or workflow you were using." Click="CaptureFeedback_Click"/>
            <Button Tag="&#128172;" Content="Review saved feed_back..." ToolTip="Review saved feedback — copy, share, export, or clean up locally gathered feedback." Click="Feedback_Click"/>
            <Button Tag="&#167;" Content="Open-source licenses..." ToolTip="Open-source licenses — review the product and third-party software notices." Click="Licenses_Click"/>
           </WrapPanel>
          </TabItem>
        </TabControl>
          <StackPanel x:Name="CommandSearchPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
              <Label Content="Search" Target="{Binding ElementName=CommandSearchBox}" VerticalAlignment="Center"/>
              <Grid Width="220">
                  <local:CommandSearchTextBox x:Name="CommandSearchBox" Style="{StaticResource {x:Type TextBox}}" MinHeight="32" VerticalContentAlignment="Center"
                           AutomationProperties.Name="Search" ToolTip="Type at least two letters to find a command. Ctrl+K focuses Search; Ctrl+Enter shows the selected command in its toolbar."
                           TextChanged="CommandSearch_TextChanged" PreviewKeyDown="CommandSearch_PreviewKeyDown"/>
                  <TextBlock Text="Find commands · Ctrl+K" Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False"
                             Foreground="{DynamicResource MutedTextBrush}">
                      <TextBlock.Style>
                          <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                  <DataTrigger Binding="{Binding Text, ElementName=CommandSearchBox}" Value="">
                                      <Setter Property="Visibility" Value="Visible"/>
                                  </DataTrigger>
                              </Style.Triggers>
                          </Style>
                      </TextBlock.Style>
                  </TextBlock>
              </Grid>
          </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Margin="0,6,0,6" Padding="12,9"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="OPERATION TARGET" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock x:Name="SelectionText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="SelectionDetailText" Margin="0,2,0,0"
                           Foreground="{DynamicResource MutedTextBrush}"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <WrapPanel x:Name="QuickActionsPanel" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Margin="12,0,0,0" MaxWidth="760">
                <WrapPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="MinHeight" Value="34"/>
                        <Setter Property="Padding" Value="7,3"/>
                        <Setter Property="Margin" Value="6,2,0,2"/>
                    </Style>
                </WrapPanel.Resources>
                <TextBlock Text="Actions:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,2,0"/>
            </WrapPanel>
            <TextBlock x:Name="SummaryText" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0"
                       FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="NetworkScopeText" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,3,0,0"
                       Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
        </Border>
        <!-- Feedback stays in its own column so it remains visible whatever else is shown. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Use the checkboxes to choose one or more computers, then choose an action. Space toggles the focused row; Ctrl+A checks every visible computer."/>
            <Button Grid.Column="1" Tag="&#9997;" Content="Feed_back · Ctrl+Shift+F"
                    ToolTip="Feedback (Ctrl+Shift+F) — describe the screen or workflow you are using."
                    AutomationProperties.Name="Send feedback, keyboard shortcut Control Shift F"
                    Click="CaptureFeedback_Click" MinHeight="28" Padding="7,1" Margin="10,1,0,0"
                    VerticalAlignment="Top"/>
        </Grid>

        <Border BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackgroundBrush}" Padding="6,4">
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                        <ToggleButton x:Name="ComputersViewButton" Content="Com_puters" IsChecked="True"
                                      MinHeight="34" Padding="8,3" Margin="0,0,6,4"
                                      ToolTip="Computers — show the classroom computer list."
                                      Click="ComputersView_Click"/>
                        <ToggleButton x:Name="OperationsViewButton" Content="_Operations"
                                      MinHeight="34" Padding="8,3" Margin="0,0,4,4"
                                      ToolTip="Operations — show current and completed operation results."
                                      Click="OperationsView_Click"/>
                        <Border x:Name="OperationsBadge" Width="30" Height="22" CornerRadius="11" Margin="0,0,6,4"
                                VerticalAlignment="Center" Background="{DynamicResource AccentBrush}" Visibility="Collapsed">
                            <TextBlock x:Name="OperationsBadgeText" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"
                                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ToggleButton x:Name="LogViewButton" Content="Lo_g"
                                      MinHeight="34" Padding="8,3" Margin="0,0,6,4"
                                      ToolTip="Log — show the chronological activity log."
                                      Click="LogView_Click"/>
                        <Border Width="1" Height="24" Margin="4,0,10,4" VerticalAlignment="Center"
                                Background="{DynamicResource BorderBrushColor}"/>
                        <!-- These act on the computer list, so they sit with it and show only in that view. -->
                        <WrapPanel x:Name="ComputerListActionsPanel">
                            <Button x:Name="ListScanButton" local:CommandState.Id="computers.scan" Tag="&#128269;" Content="_Scan network" ToolTip="Scan network — discover Classroom Client computers on the subnet selected in Host settings without polling unassigned computers."
                                    IsEnabled="{Binding IsEnabled, ElementName=ScanButton}" Click="Scan_Click" MinHeight="34" Padding="8,3" Margin="0,0,6,4"/>
                            <Button local:CommandState.Id="computers.refresh" Tag="&#128260;" Content="Re_fresh status" ToolTip="Refresh status (F5) — check computers assigned to rooms now."
                                    Click="Refresh_Click" MinHeight="34" Padding="8,3" Margin="0,0,6,4"/>
                            <Button local:CommandState.Id="computers.wake" Tag="&#9889;" Content="_Wake up" ToolTip="Wake up — send Wake-on-LAN packets to selected computers; on computers that are already on, stop the screen saver and turn the display on."
                                    Click="Wake_Click" MinHeight="34" Padding="8,3" Margin="0,0,6,4"/>
                            <Button Tag="&#9745;" Content="A_ll" ToolTip="Select all — select every visible computer in the current room filter."
                                    Click="SelectAll_Click" MinHeight="34" Padding="8,3" Margin="0,0,6,4"/>
                            <Button Tag="&#11036;" Content="_None" ToolTip="Select none (Esc) — clear the computer selection."
                                    Click="SelectNone_Click" MinHeight="34" Padding="8,3" Margin="0,0,6,4"/>
                            <Button Tag="&#8644;" Content="In_vert" ToolTip="Invert selection — select the visible computers that are not selected and clear the ones that are."
                                    Click="SelectInvert_Click" MinHeight="34" Padding="8,3" Margin="0,0,6,4"/>
                            <Button Tag="&#9679;" Content="O_nline" ToolTip="Select online — select visible computers currently online."
                                    Click="SelectOnline_Click" MinHeight="34" Padding="8,3" Margin="0,0,6,4"/>
                            <Button Tag="&#9675;" Content="Offl_ine" ToolTip="Select offline — select visible computers that did not answer the last check."
                                    Click="SelectOffline_Click" MinHeight="34" Padding="8,3" Margin="0,0,6,4"/>
                            <Button Tag="&#9776;" Content="C_olumns..." ToolTip="Columns — choose which computer-list columns are visible."
                                    Click="Columns_Click" MinHeight="34" Padding="8,3" Margin="0,0,6,4"/>
                        </WrapPanel>
                        <WrapPanel x:Name="OperationActionsPanel" Visibility="Collapsed">
                        <Button x:Name="OpenResultsButton" Content="_Open results" MinHeight="34" Padding="8,3" Margin="0,0,6,4"
                                ToolTip="Open results — show the per-computer results of the selected operation (or double-click it)."
                                Click="OpenOperationResults_Click"/>
                        <Button x:Name="CloseResultsButton" Content="Clos_e results" MinHeight="34" Padding="8,3" Margin="0,0,6,4"
                                IsEnabled="False"
                                ToolTip="Close results — fold the per-computer results away so the list of operations is visible again."
                                Click="CloseOperationResults_Click"/>
                        <Button Content="_Cancel" MinHeight="34" Padding="8,3" Margin="0,0,6,4"
                                IsEnabled="{Binding SelectedItem.CanCancel, ElementName=OperationsGrid}"
                                ToolTip="Stop queued computers after active requests finish."
                                Click="CancelOperation_Click"/>
                        <Button Content="_Retry failed" MinHeight="34" Padding="8,3" Margin="0,0,6,4"
                                IsEnabled="{Binding SelectedItem.CanRetry, ElementName=OperationsGrid}"
                                ToolTip="Run this repeatable action again only on computers that failed."
                                Click="RetryFailedOperation_Click"/>
                        <Button Content="_Undo" MinHeight="34" Padding="8,3" Margin="0,0,6,4"
                                IsEnabled="{Binding SelectedItem.CanUndo, ElementName=OperationsGrid, FallbackValue=False}"
                                ToolTip="Undo — take the selected operation back on the computers it succeeded on: unlock after a lock, hide a message, cancel a pending shutdown, restore the previous wallpaper or screen saver."
                                Click="UndoOperation_Click"/>
                        <Button Content="Review _warnings" MinHeight="34" Padding="8,3" Margin="0,0,6,4"
                                IsEnabled="{Binding SelectedItem.HasWarnings, ElementName=OperationsGrid}"
                                ToolTip="Review warnings — reopen the cautions shown before this operation started."
                                Click="ReviewOperationWarnings_Click"/>
                        <Button Content="_Copy details" MinHeight="34" Padding="8,3" Margin="0,0,6,4"
                                Click="CopyOperationDetails_Click"
                                ToolTip="Copy details — copy the selected operation and its per-computer results."/>
                        <Button Content="Clear _completed" MinHeight="34" Padding="8,3" Margin="0,0,6,4"
                                Click="ClearCompletedOperations_Click"
                                ToolTip="Clear completed — remove finished operations while keeping running work visible."/>
                        </WrapPanel>
                        <WrapPanel x:Name="LogActionsPanel" Visibility="Collapsed">
                        <Button Tag="&#9881;" Content="Logging _options..." MinHeight="34" Padding="8,3" Margin="0,0,6,4"
                                ToolTip="Logging options — keep the activity log on this computer or not, and for how many days."
                                Click="LoggingOptions_Click"/>
                        <Button Content="_Export log..." MinHeight="34" Padding="8,3" Margin="0,0,6,4"
                                ToolTip="Export log — save what this view shows as a text file."
                                Click="ExportLog_Click"/>
                        <Button Content="Open log _folder" MinHeight="34" Padding="8,3" Margin="0,0,6,4"
                                ToolTip="Open log folder — the Host writes every log line to a dated file there, for later review."
                                Click="OpenLogFolder_Click"/>
                        <Button Content="_Copy all" MinHeight="34" Padding="8,3" Margin="0,0,6,4"
                                ToolTip="Copy all — copy every line of this view to the clipboard."
                                Click="CopyLog_Click"/>
                        </WrapPanel>
                    </WrapPanel>
                    </Grid>
                </Border>
                <TextBlock DockPanel.Dock="Bottom" Margin="10,4" TextWrapping="Wrap"
                           Text="{Binding SelectedItem.Latest, ElementName=OperationsGrid}"
                           Style="{StaticResource StatusTextStyle}"
                           AutomationProperties.Name="Selected operation status"/>
                <!-- SelectedIndex is set here because this template has no tab strip: WPF only selects the
                     first tab by itself once a tab strip has been built, so without it the view starts empty. -->
                <TabControl x:Name="OperationsTabs" Padding="0" SelectedIndex="0">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabItem Header="Computers">
                        <Border x:Name="ComputerListBorder" BorderBrush="Transparent" BorderThickness="0" Padding="0">
                        <Grid>
                        <DataGrid x:Name="ClientGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                                  CanUserResizeColumns="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectionChanged="ClientGrid_SelectionChanged"
                                  PreviewKeyDown="ClientGrid_PreviewKeyDown" MouseDoubleClick="ClientGrid_DoubleClick" AutomationProperties.Name="Classroom computers">
                            <!-- Every column fits its title and contents; Status takes the rest and is the widest. -->
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Select" Width="Auto" SortMemberPath="IsSelected">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="SelectionCheckBox_Click"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      AutomationProperties.Name="Select computer"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="State" SortMemberPath="Status" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="&#9679;" FontSize="15" HorizontalAlignment="Center"
                                                       AutomationProperties.Name="{Binding Status}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource StateUnknownBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="ok"><Setter Property="Foreground" Value="{DynamicResource StateOkBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="idle"><Setter Property="Foreground" Value="{DynamicResource StateIdleBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="warn"><Setter Property="Foreground" Value="{DynamicResource StateWarnBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="bad"><Setter Property="Foreground" Value="{DynamicResource StateBadBrush}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Computer" Binding="{Binding Name}" Width="Auto"/>
                                <DataGridTextColumn Header="Room" Binding="{Binding Room}" Width="Auto"/>
                                <DataGridTextColumn Header="Lab key" Binding="{Binding KeyName}" Width="Auto"/>
                                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="Auto"/>
                                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="Auto"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" MinWidth="260"/>
                                <DataGridTextColumn Header="Ping" Binding="{Binding Ping}" Width="Auto"/>
                                <DataGridTextColumn Header="Clock" Binding="{Binding Clock}" Width="Auto"/>
                                <DataGridTextColumn Header="Uptime" Binding="{Binding Uptime}" Width="Auto"/>
                                <DataGridTextColumn Header="Protocol" Binding="{Binding Version}" Width="Auto"/>
                                <DataGridTextColumn Header="OS Version" Binding="{Binding WindowsVersion}" Width="Auto"/>
                                <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceLanguage}" Width="Auto"/>
                                <DataGridTextColumn Header="Hosts" Binding="{Binding BlockedWebsiteCount}" Width="Auto"/>
                                <DataGridTextColumn Header="Apps" Binding="{Binding OpenWindows}" Width="Auto"/>
                                <DataGridTextColumn Header="Client" Binding="{Binding AppVersion}" Width="Auto"/>
                                <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeen}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="EmptyStatePanel" Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Padding="24"
                                IsHitTestVisible="False" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                                <TextBlock Text="No computers to show" FontSize="18" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="EmptyStateText" TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>
                        </Grid>
                        </Border>
                    </TabItem>
                    <TabItem Header="Operations">
                        <!-- The operations on the left and, once Open results is pressed, the computers of the selected
                             one on the right: two tables side by side, each with its own single scroll bar, so every
                             computer of a large room can be reached and no scroll area sits inside another. -->
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="320"/>
                            <ColumnDefinition x:Name="OperationResultsSplitterColumn" Width="0"/>
                            <ColumnDefinition x:Name="OperationResultsColumn" Width="0"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="OperationsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                                  MouseDoubleClick="OperationsGrid_DoubleClick"
                                  AutomationProperties.Name="Recent operations">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="155"/>
                                <DataGridTextColumn Header="Operation" Binding="{Binding Title}" Width="190"/>
                                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="210"/>
                                <DataGridTextColumn Header="Progress" Binding="{Binding ProgressText}" Width="75"/>
                                <DataGridTextColumn Header="Latest update" Binding="{Binding Latest}" Width="*"/>
                                <DataGridTextColumn Header="Started" Binding="{Binding StartedText}" Width="75"/>
                                <DataGridTextColumn Header="Elapsed" Binding="{Binding ElapsedText}" Width="75"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="OperationsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="520" IsHitTestVisible="False">
                            <TextBlock Text="Choose computers and start an action. Running work and per-computer results will remain available here."
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                        <GridSplitter x:Name="OperationResultsSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                      Visibility="Collapsed" Background="{DynamicResource BorderBrushColor}"
                                      AutomationProperties.Name="Resize the results of the selected operation"/>
                        <DockPanel x:Name="OperationResultsPanel" Grid.Column="2" Visibility="Collapsed" Margin="6,0,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedItem.Recovery, ElementName=OperationsGrid}"
                                       TextWrapping="Wrap" FontWeight="SemiBold" Margin="2,4,2,6" AutomationProperties.LiveSetting="Polite"/>
                            <DataGrid x:Name="OperationResultsGrid" ItemsSource="{Binding SelectedItem.Results, ElementName=OperationsGrid}"
                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      CanUserAddRows="False" AutomationProperties.Name="Computers of the selected operation">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Computer" Binding="{Binding Computer}" Width="140"/>
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90"/>
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Log">
                        <ListBox x:Name="LogList" FontFamily="Consolas"
                                 AutomationProperties.Name="Activity log"/>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
