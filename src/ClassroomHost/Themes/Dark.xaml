<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#292929"/>
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="BorderBrushColor" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#B3B3B3"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#101010"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#323232"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#3E3E3E"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#7C7C7C"/>
    <SolidColorBrush x:Key="GridAlternateRowBrush" Color="#252525"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#303030"/>
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonInteractiveTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#0B4F8A"/>
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#353535"/>
    <SolidColorBrush x:Key="TabStripBackgroundBrush" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="TabBackgroundBrush" Color="#242424"/>
    <SolidColorBrush x:Key="TabHoverBrush" Color="#333333"/>
    <SolidColorBrush x:Key="TabSelectedBackgroundBrush" Color="#303030"/>
    <SolidColorBrush x:Key="TabSelectedForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabBorderBrush" Color="#505050"/>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarBorderBrush" Color="#3D3D3D"/>
    <!-- Borders of boxes people type or choose in, which need to stand out from the surface around them. -->
    <SolidColorBrush x:Key="InputBorderBrush" Color="#7C7C7C"/>
    <!-- The state dot of a computer: must be told apart from every row background, selected rows included. -->
    <SolidColorBrush x:Key="StateOkBrush" Color="#5CD67E"/>
    <SolidColorBrush x:Key="StateIdleBrush" Color="#F2C94C"/>
    <SolidColorBrush x:Key="StateWarnBrush" Color="#FFA94D"/>
    <SolidColorBrush x:Key="StateBadBrush" Color="#FF7B7B"/>
    <SolidColorBrush x:Key="StateUnknownBrush" Color="#B4BAC0"/>

</ResourceDictionary>
