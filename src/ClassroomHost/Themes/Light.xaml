<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="BorderBrushColor" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#666666"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#A4160F"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#E1E1E1"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#B8B8B8"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#858585"/>
    <SolidColorBrush x:Key="GridAlternateRowBrush" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ButtonInteractiveTextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#CDE8FF"/>
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#E8F3FC"/>
    <SolidColorBrush x:Key="TabStripBackgroundBrush" Color="#ECECEC"/>
    <SolidColorBrush x:Key="TabBackgroundBrush" Color="#E4E4E4"/>
    <SolidColorBrush x:Key="TabHoverBrush" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="TabSelectedBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabSelectedForegroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TabBorderBrush" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TitleBarBorderBrush" Color="#D0D0D0"/>
    <!-- Borders of boxes people type or choose in, which need to stand out from the surface around them. -->
    <SolidColorBrush x:Key="InputBorderBrush" Color="#858585"/>
    <!-- The state dot of a computer: must be told apart from every row background, selected rows included. -->
    <SolidColorBrush x:Key="StateOkBrush" Color="#1E7E34"/>
    <SolidColorBrush x:Key="StateIdleBrush" Color="#8A6A00"/>
    <SolidColorBrush x:Key="StateWarnBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="StateBadBrush" Color="#C62828"/>
    <SolidColorBrush x:Key="StateUnknownBrush" Color="#6B7280"/>

</ResourceDictionary>
