<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Reloaded whenever Windows contrast settings change, so these static system colours track
         the active contrast theme while keeping the same semantic resource contract as Light/Dark. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="{x:Static SystemColors.ControlTextColor}"/>
    <SolidColorBrush x:Key="BorderBrushColor" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{x:Static SystemColors.GrayTextColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{x:Static SystemColors.HighlightTextColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{x:Static SystemColors.ControlTextColor}"/>
    <SolidColorBrush x:Key="GridAlternateRowBrush" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="SelectionTextBrush" Color="{x:Static SystemColors.HighlightTextColor}"/>
    <SolidColorBrush x:Key="ButtonInteractiveTextBrush" Color="{x:Static SystemColors.HighlightTextColor}"/>
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="ItemHoverBrush" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="TabStripBackgroundBrush" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="TabBackgroundBrush" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="TabHoverBrush" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="TabSelectedBackgroundBrush" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="TabSelectedForegroundBrush" Color="{x:Static SystemColors.HighlightTextColor}"/>
    <SolidColorBrush x:Key="TabBorderBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="TitleBarBorderBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
    <!-- Borders of boxes people type or choose in, which need to stand out from the surface around them. -->
    <SolidColorBrush x:Key="InputBorderBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
    <!-- The state dot of a computer: must be told apart from every row background, selected rows included. -->
    <SolidColorBrush x:Key="StateOkBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="StateIdleBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="StateWarnBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="StateBadBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="StateUnknownBrush" Color="{x:Static SystemColors.WindowTextColor}"/>

</ResourceDictionary>
