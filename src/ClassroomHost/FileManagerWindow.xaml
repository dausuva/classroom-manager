<Window x:Class="ClassroomManager.Host.FileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="820" Height="560" MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Content="_Up" Click="Up_Click"/>
            <Button DockPanel.Dock="Right" Content="_Go" Margin="6,0,0,0" Click="Go_Click"/>
            <Label DockPanel.Dock="Left" Content="_Path:" Target="{Binding ElementName=PathBox}" Padding="0"
                   VerticalAlignment="Center" Margin="8,0,6,0"/>
            <TextBox x:Name="PathBox" KeyDown="PathBox_KeyDown" AutomationProperties.Name="Path"/>
        </DockPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Content="_Refresh" ToolTip="Refresh (F5) — reload the current remote folder" Click="Refresh_Click"/>
            <Button Content="_Upload files..." Click="Upload_Click"/>
            <Button Content="_Download..." Click="Download_Click"/>
            <Button Content="_New folder..." Click="NewFolder_Click"/>
            <Button Content="R_ename..." Click="Rename_Click"/>
            <Button Content="De_lete" Click="Delete_Click"/>
        </WrapPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                   Style="{StaticResource StatusTextStyle}"/>

        <ListView x:Name="FileList" SelectionMode="Extended" MouseDoubleClick="FileList_DoubleClick"
                  AutomationProperties.Name="Remote files and folders">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="380" DisplayMemberBinding="{Binding DisplayName}"/>
                    <GridViewColumn Header="Size" Width="110" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="Modified" Width="150" DisplayMemberBinding="{Binding Modified}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
