msgstr "Egzamino režimo nustatymai"

#: ClassroomHost/MainWindow.Settings.cs
msgid "These websites and programs are added as a separate exam overlay. Turning Exam mode off removes only the overlay and preserves the client's normal block lists."
msgstr "Šios svetainės ir programos pridedamos kaip atskiras egzamino apribojimas. Išjungus egzamino režimą pašalinamas tik šis apribojimas, o įprasti kliento blokavimo sąrašai išlieka."

#: ClassroomHost/MainWindow.Settings.cs
msgid "Blocked websites (one per line or comma-separated)"
msgstr "Blokuojamos svetainės (po vieną eilutėje arba atskirtos kableliais)"

#: ClassroomHost/MainWindow.Settings.cs
msgid "Blocked apps/processes (one per line or comma-separated)"
msgstr "Blokuojamos programos / procesai (po vieną eilutėje arba atskirti kableliais)"

#: ClassroomHost/MainWindow.Settings.cs
msgid "Mute speakers and microphones"
msgstr "Nutildyti garsiakalbius ir mikrofonus"

#: ClassroomHost/MainWindow.Settings.cs
msgid "Turn cameras off and close the Camera app"
msgstr "Išjungti kameras ir užverti programą „Kamera“"

#: ClassroomHost/MainWindow.Settings.cs
msgid "Block USB drives, phones and other removable storage"
msgstr "Blokuoti USB atmintines, telefonus ir kitas keičiamąsias laikmenas"

#: ClassroomHost/MainWindow.Settings.cs
