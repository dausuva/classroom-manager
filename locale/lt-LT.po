msgstr "{0} iš {1} kompiuterių senesni nei protokolas {2} ({3}); {4} senesni nei {5} ir gauna nesusietą rakto įrodymą."

#: ClassroomHost/LabSecurityReport.cs
msgid "ClassroomCli update --all --client <signed ClassroomClient.exe> --yes"
msgstr "ClassroomCli update --all --client <pasirašytas ClassroomClient.exe> --yes"

