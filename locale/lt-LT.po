msgstr "Visi {0} pranešti sertifikatai galioja dar 90 dienų ar ilgiau ir nė vienas ilgiau nei dešimt metų."

#: ClassroomHost/LabSecurityReport.cs
msgid "Up-to-date Clients"
msgstr "Atnaujinti klientai"

#: ClassroomHost/LabSecurityReport.cs
msgid "All {0} computers speak protocol {1}: the key proof is bound to the TLS session and discovery is authenticated."
msgstr "Visi {0} kompiuteriai kalba protokolu {1}: rakto įrodymas susietas su TLS ryšiu, o aptikimas autentifikuotas."

