msgstr "Išvaizda"

#: ClassroomHost/MainWindow.Settings.cs
msgid "Toolbar buttons"
msgstr "Įrankių juostos mygtukai"

#: ClassroomHost/MainWindow.Settings.cs
msgid "Host interface mode"
msgstr "Programos sąsajos režimas"

#: ClassroomHost/MainWindow.Settings.cs
