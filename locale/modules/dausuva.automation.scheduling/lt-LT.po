#: ClassroomHost/SchedulesWindow.cs
msgid "Catch up: computers that are off at that time get it as soon as they are online, until the next time (not for lock, message, wake or power)"
msgstr "Pasivyti: tuo metu išjungti kompiuteriai jį gauna, kai tik prisijungia, iki kito karto (ne užrakinimui, pranešimui, pažadinimui ar maitinimui)"

